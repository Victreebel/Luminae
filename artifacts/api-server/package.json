{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && node --env-file=../../.env --import tsx ./src/index.ts",
    "dev:watch": "export NODE_ENV=development && node --env-file=../../.env --watch --import tsx ./src/index.ts",
    "dev:compiled": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps ./dist/index.mjs",
    "typecheck": "pnpm run lint && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "simulate": "tsx ./src/scripts/simulate.ts",
    "simulate:artifacts": "tsx ./src/scripts/simulateArtifacts.ts",
    "simulate:blueprints": "tsx ./src/scripts/simulateBlueprints.ts",
    "backfill:account-progress": "node --env-file=../../.env --import tsx ./src/scripts/backfillAccountProgress.ts",
    "db:migrate": "pnpm --filter @workspace/db migrate",
    "test": "vitest run --config vitest.config.ts",
    "verify:coordination": "vitest run --config vitest.config.ts src/lib/devRewind.test.ts src/lib/turnPresentationGate.test.ts src/lib/stateProjection.test.ts && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/game-types": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "pino": "^9",
    "pino-http": "^10",
    "resend": "^6.12.3",
    "ws": "^8.21.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@typescript-eslint/parser": "^8.59.4",
    "esbuild": "0.25.8",
    "esbuild-plugin-pino": "^2.3.3",
    "eslint": "^9.39.4",
    "globals": "^16.0.0",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0",
    "tsx": "catalog:",
    "vitest": "^4.1.6"
  }
}
