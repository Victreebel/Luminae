{
  "name": "@workspace/scripts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "hello": "tsx ./src/hello.ts",
    "normalize:affinities": "python3 ./src/normalize-affinity-tokens.py",
    "compress:art": "python3 ./src/compress-art-assets.py",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint:version-stamps": "tsx ./src/check-version-stamps.ts",
    "lint:terminology": "tsx ./src/check-luminae-terminology.ts",
    "lint:summon-colors": "tsx ./src/check-summon-colors.ts",
    "lint:luminary-files": "tsx ./src/check-luminary-files.ts",
    "test:version-stamps": "tsx ./src/check-version-stamps.test.ts",
    "test:summon-colors": "tsx ./src/check-summon-colors.test.ts",
    "test:luminary-files": "tsx ./src/check-luminary-files.test.ts",
    "audit:overlays": "node overlay-audit/audit-overlays.cjs",
    "test:overlays": "playwright test --config=playwright.config.ts overlay-audit/overlay-centering.spec.ts",
    "test:dialog-keyboard": "playwright test --config=dialog-keyboard.config.ts",
    "test:ws-keepalive": "playwright test --config=connection-stability.config.ts",
    "probe:ws-external": "tsx ./src/ws-external-probe.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:"
  },
  "dependencies": {
    "playwright": "^1.60.0"
  }
}
