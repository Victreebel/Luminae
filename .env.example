# Runtime
NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql:///luminae
LUMINAE_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5191
LUMINAE_PUBLIC_APP_URL=http://localhost:5173
LUMINAE_OPS_HEALTH_SECRET=replace-in-deployment
LUMINAE_PURCHASE_RECONCILIATION_SECRET=replace-in-deployment

# Email/password recovery
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Web and native client
# Keep blank for same-origin web requests through the Vite proxy.
VITE_LUMINAE_API_ORIGIN=
VITE_LUMINAE_OPERATOR_NAME=Local Development
VITE_LUMINAE_SUPPORT_EMAIL=support@example.invalid
VITE_LUMINAE_TELEMETRY=on
LUMINAE_WEB_URL=https://play.example.invalid

# Reproducible release identity
LUMINAE_RELEASE_VERSION=0.1.0-early-access
LUMINAE_BUILD_LABEL=local-development
LUMINAE_BUILD_STAMP=local-development
SOURCE_DATE_EPOCH=
LUMINAE_ANDROID_VERSION_CODE=1

# Google Play verification. Supply the complete service-account JSON as one value.
GOOGLE_PLAY_PACKAGE_NAME=com.luminae.game
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Samsung IAP server verification
SAMSUNG_IAP_PACKAGE_NAME=com.luminae.game
SAMSUNG_IAP_SERVICE_ACCOUNT_ID=
SAMSUNG_IAP_ACCESS_TOKEN=

# Desktop development only. Production uses LUMINAE_WEB_URL and never starts local services.
LUMINAE_DESKTOP_DEV=0
